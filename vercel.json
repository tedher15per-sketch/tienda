{
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "Permissions-Policy", "value": "camera=(self)" },
      { "key": "X-Content-Type-Options", "value": "nosniff" }
    ]},
    { "source": "/(app|db|config).js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
